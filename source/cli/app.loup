@mode(host.dual)

# Top level of cat: parse the arguments, handle --help and --version, run
# the command and turn the outcome into an exit status (1 for a usage
# error, as GNU cat does).
#
# Runtime: host.dual. Compiled into the native binary build/cat by `make
# build`; `loup run source/main.loup` interprets the same code, and the unit
# tests call run() directly.

from appinfo import (APP_NAME, EXIT_OK, EXIT_FAILURE, EXIT_USAGE);
from cli.args import (parse_args);
from cli.usage import (usage, version_line);
from commands.cat import (run_cat);

# Parses argv, runs cat and returns the exit status.
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(msg) => {
            printErr(i"{$ APP_NAME $}: {$ msg $}");
            printErr(i"Try '{$ APP_NAME $} --help' for more information.");
            return EXIT_USAGE;
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }

    try {
        return run_cat(opts);
    } catch (Exception as e) {
        printErr(i"{$ APP_NAME $}: {$ e.message $}");
        return EXIT_FAILURE;
    }
}
