@mode(host.dual)

# Command-line parsing for cat, following GNU getopt_long: short options may
# be combined (`-nE`), options and operands may be mixed, `--` ends the
# options, a lone `-` is an operand (standard input), and a long option may
# be abbreviated to any unique prefix (`--squeeze`, but not `--show`).

pub struct Options {
    pub help: bool;
    pub version: bool;
    pub number: bool;
    pub number_nonblank: bool;
    pub squeeze_blank: bool;
    pub show_ends: bool;
    pub show_tabs: bool;
    pub show_nonprinting: bool;
    pub operands: list[string];
}

# cat's long options, in GNU's order (the order of an ambiguity message).
pub func long_names(): list[string] {
    return [
        "number-nonblank",
        "number",
        "squeeze-blank",
        "show-nonprinting",
        "show-ends",
        "show-tabs",
        "show-all",
        "help",
        "version",
    ];
}

# Resolves the name of a long option (`given`, without `--` or `=VALUE`)
# against `names` as getopt_long does: an exact name wins, otherwise the
# name must be the prefix of exactly one option. `arg` is the argument as
# typed, for the error message.
pub func match_long(given: string, arg: string, names: list[string]): Result[string, string] {
    var found: list[string] = [];
    for (name in names) {
        if (name == given) {
            return Ok(name);
        }
        if (name.startsWith(given)) {
            found.push(name);
        }
    }
    if (found.len() == 1) {
        return Ok(found[0]);
    }
    if (found.len() == 0) {
        return Err(i"unrecognized option '{$ arg $}'");
    }
    var listed: list[string] = [];
    for (name in found) {
        listed.push(i"'--{$ name $}'");
    }
    return Err(i"option '{$ arg $}' is ambiguous; possibilities: {$ listed.join(" ") $}");
}

pub func parse_args(argv: list[string]): Result[Options, string] {
    var help = false;
    var version = false;
    var number = false;
    var number_nonblank = false;
    var squeeze_blank = false;
    var show_ends = false;
    var show_tabs = false;
    var show_nonprinting = false;
    var operands: list[string] = [];
    var only_operands = false;

    for (arg in argv) {
        if (help or version) {
            break;
        }
        if (only_operands or arg == "-" or !arg.startsWith("-")) {
            operands.push(arg);
        } else if (arg == "--") {
            only_operands = true;
        } else if (arg.startsWith("--")) {
            let body = arg.slice(2);
            let eq = body.index_of("=");
            let given = if (eq >= 0) { body.slice(0, eq) } else { body };
            let name = match match_long(given, arg, long_names()) {
                Ok(found) => found,
                Err(msg) => {
                    return Err(msg);
                },
            };
            if (eq >= 0) {
                return Err(i"option '--{$ name $}' doesn't allow an argument");
            }
            if (name == "number-nonblank") {
                number_nonblank = true;
            } else if (name == "number") {
                number = true;
            } else if (name == "squeeze-blank") {
                squeeze_blank = true;
            } else if (name == "show-nonprinting") {
                show_nonprinting = true;
            } else if (name == "show-ends") {
                show_ends = true;
            } else if (name == "show-tabs") {
                show_tabs = true;
            } else if (name == "show-all") {
                show_nonprinting = true;
                show_ends = true;
                show_tabs = true;
            } else if (name == "help") {
                help = true;
            } else {
                version = true;
            }
        } else {
            for (letter in arg.slice(1)) {
                if (letter == "A") {
                    show_nonprinting = true;
                    show_ends = true;
                    show_tabs = true;
                } else if (letter == "b") {
                    number_nonblank = true;
                } else if (letter == "e") {
                    show_nonprinting = true;
                    show_ends = true;
                } else if (letter == "E") {
                    show_ends = true;
                } else if (letter == "n") {
                    number = true;
                } else if (letter == "s") {
                    squeeze_blank = true;
                } else if (letter == "t") {
                    show_nonprinting = true;
                    show_tabs = true;
                } else if (letter == "T") {
                    show_tabs = true;
                } else if (letter == "v") {
                    show_nonprinting = true;
                } else if (letter != "u") {
                    return Err(i"invalid option -- '{$ letter $}'");
                }
            }
        }
    }

    return Ok(Options(
        help = help,
        version = version,
        number = number or number_nonblank,
        number_nonblank = number_nonblank,
        squeeze_blank = squeeze_blank,
        show_ends = show_ends,
        show_tabs = show_tabs,
        show_nonprinting = show_nonprinting,
        operands = operands,
    ));
}
